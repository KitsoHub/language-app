{
  "cli": {
    "version": ">= 15.0.12",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
       "buildType": "app-bundle"
    }
    },
    "preview": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "preview",
      "android": {
       "buildType": "app-bundle"
    }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "android": {
       "buildType": "app-bundle"
    }
    }
  },
  "submit": {
    "production": {}
  }
}
